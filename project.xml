<?xml version="1.0" encoding="utf-8"?>
<project>
	<meta title="Dungeon Rampage Haxe" package="com.dungeonrampage.haxe" version="1.0.0" company="Tutez" />
	<app main="DungeonBustersProject" file="Dungeon Rampage Haxe" swf-version="32" />
	<window width="1920" height="1080" fps="120" background="#000000" hardware="true" allow-shaders="true" require-shaders="true" />
	<icon path="icon.jpg" />

	<set name="APP_FILE" value="Dungeon Rampage Haxe" />

	<haxelib name="steamwrap" if="cpp" />
	<haxelib name="hxcpp" if="cpp" />
	<haxelib name="lime" if="cpp" />
	<haxelib name="swf" if="cpp" />
	<define name="draft" />
	<haxelib name="openfl" />
	<!-- Last -cp wins; Lime appends draft-api after OpenFL src, which overlays Context3D. -->
	<source path="submodules/openfl/src" if="cpp" />
	<haxelib name="hxscript" if="cpp" />
	<haxelib name="format" if="cpp" />

	<!-- cppia host, docs/modding.md Compilation. -->
	<haxedef name="hxscript_cppia" if="cpp" />
	<haxedef name="scriptable" if="cpp" />
	<haxedef name="hxscript_verbose" if="cpp" />
	<haxedef name="hxscript_host" value="modding" if="cpp" />
	<haxedef name="hxscript_bridge_classpath" value="src,src-steam,compat" if="cpp" />
	<haxedef name="hxscript_bridge_exclude" value="DungeonBustersProject,openfl.fl,openfl.data,openfl.net.WebSocket,openfl.net.ServerWebSocket,openfl.net._internal.NativeLocalConnection,openfl.xml,openfl.display._internal.native,openfl.media._internal.NativeVideoBackend,lime._internal.backend.html5,lime._internal.backend.air,lime._internal.backend.flash,lime._internal.backend.emscripten,lime.tools,swf.exporters.AnimateLibraryExporter,swf.exporters.SWFLiteExporter,swf.exporters.swflite.SWFLiteLoader,swf.exporters.AS3GraphicsDataShapeExporter,swf.exporters.FrameScriptParser,swf.data.actions.swf3.ActionNextFrame,swf.data.actions.swf3.ActionGotoFrame,swf.data.actions.swf3.ActionGetURL,swf.data.actions.swf3.ActionGotoLabel,box2D.common.b2internal,org.as3commons.collections.framework.core.as3commons_collections" if="cpp" />
	<haxedef name="hxscript_bridge_packages" value="openfl,lime,swf,steamwrap" if="cpp" />
	<haxedef name="hxscript_keep" value="cpp.vm.Gc,cpp.vm.Profiler" if="cpp" />
	<haxeflag name="-dce" value="no" if="cpp" />
	<haxeflag name="--macro" value="include('haxe', true, ['haxe.macro', 'haxe.atomic.AtomicObject'])" if="cpp" />
	<haxeflag name="--macro" value="include('sys', true, ['sys.db'])" if="cpp" />

	<haxedef name="HXCPP_GC_BIG_BLOCKS" />
	<haxedef name="HXCPP_GC_GENERATIONAL" />
	<haxedef name="HXCPP_GC_SUMMARY" />
	<haxedef name="analyzer-optimize" />
	<haxedef name="swf_compact_animate_timelines" />
	<haxedef name="swf_hardware_bitmap_cache" />

	<setenv name="STEAM_APP_ID" value="3053950" if="cpp" />
	<dependency name="com.amanitadesign.steam.FRESteamWorks" path="extensions/FRESteamWorks.ane" if="air" />

	<source path="src" />
	<source path="src-steam" if="cpp" />
	<source path="compat" />

	<assets path="Resources" embed="false" exclude="*.swf" if="cpp" />
	<assets path="Resources" embed="false" if="air" />
	<assets path="DbConfiguration" embed="false" />

	<prebuild command="haxe edits/ffdec_fonts/export_swf_fonts.hxml" if="cpp" />
	<postbuild command="haxe edits/ffdec_fonts/export_swf_fonts.hxml" if="cpp" />
	<!-- Regenerated by haxe edits/swf_libraries/generate.hxml before cpp builds. -->
	<include path="generated_swf_libraries.xml" if="cpp" />
	<library path="src/_assets/assets.swf" preload="true" if="cpp" />
	<haxeflag name="-swf-lib" value="src/_assets/assets.swf" if="air" />
</project>
