+      kind = 1;
+   else if (name=="Class")
+      kind = 2;
+   else
+   {
+      // HXCPP_GC_CENSUS_TRACK=<class>,<class>: classes counted by owner as the generic ones are
+      static std::string track = std::string(",") + (getenv("HXCPP_GC_CENSUS_TRACK") ? getenv("HXCPP_GC_CENSUS_TRACK") : "") + ",";
+      if (track.find("," + name + ",")!=std::string::npos)
+         kind = 3;
+   }
+   sBenchKind[inClass] = kind;
+   return kind;
